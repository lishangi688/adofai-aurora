<Page x:Class="AdofaiModManager.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:svc="clr-namespace:AdofaiModManager.Services"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="设置">
    <ScrollViewer svc:SmoothScroll.IsEnabled="True" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="设置" />

            <!-- 外观 -->
            <TextBlock Margin="0,32,0,8" FontSize="16" FontWeight="SemiBold" Text="外观" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ThemeSystem"
                             Margin="0,0,24,0"
                             Checked="Theme_Checked"
                             Content="跟随系统"
                             GroupName="Theme"
                             Tag="System" />
                <RadioButton x:Name="ThemeLight"
                             Margin="0,0,24,0"
                             Checked="Theme_Checked"
                             Content="浅色"
                             GroupName="Theme"
                             Tag="Light" />
                <RadioButton x:Name="ThemeDark"
                             Checked="Theme_Checked"
                             Content="深色"
                             GroupName="Theme"
                             Tag="Dark" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.6"
                       Text="「跟随系统」会自动读取 Windows 的浅色 / 深色模式，并在系统切换时实时跟随。"
                       TextWrapping="Wrap" />

            <!-- 游戏目录 -->
            <TextBlock Margin="0,32,0,8" FontSize="16" FontWeight="SemiBold" Text="游戏目录" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="GamePathBox"
                            Grid.Column="0"
                            PlaceholderText="例如 D:\SteamLibrary\steamapps\common\A Dance of Fire and Ice"
                            TextChanged="GamePathBox_TextChanged" />
                <ui:Button x:Name="AutoDetectButton"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           Click="AutoDetectButton_Click"
                           Content="自动检测"
                           Icon="{ui:SymbolIcon Symbol=Search24}" />
                <ui:Button x:Name="BrowseButton"
                           Grid.Column="2"
                           Margin="8,0,0,0"
                           Click="BrowseButton_Click"
                           Content="浏览…"
                           Icon="{ui:SymbolIcon Symbol=FolderOpen24}" />
            </Grid>
            <TextBlock x:Name="GameStatusText"
                       Margin="0,8,0,0"
                       Opacity="0.7"
                       TextWrapping="Wrap" />

            <TextBlock Margin="0,16,0,8" FontSize="14" FontWeight="SemiBold" Text="游戏版本" />
            <ui:TextBox x:Name="GameVersionBox"
                        PlaceholderText="留空则自动检测"
                        TextChanged="GameVersionBox_TextChanged" />
            <TextBlock x:Name="GameVersionStatusText"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.75"
                       TextWrapping="Wrap" />

            <!-- 来源总览 -->
            <TextBlock Margin="0,32,0,8" FontSize="16" FontWeight="SemiBold" Text="来源" />
            <TextBlock Margin="0,0,0,6"
                       FontSize="12"
                       Opacity="0.6"
                       Text="Aurora 支持下面这些 mod 来源，可在「在线 Mod」页右上角切换。点击网址可以打开对应网站。"
                       TextWrapping="Wrap" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SourceSiteNameText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="ADOFAITools" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center">
                    <Hyperlink x:Name="SourceSiteHyperlink" Click="WebLink_Click" RequestNavigate="WebLink_RequestNavigate" />
                </TextBlock>
            </Grid>
            <Grid x:Name="CustomSourceRow" Margin="0,4,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CustomSourceNameText" Grid.Column="0" VerticalAlignment="Center" />
                <TextBlock x:Name="CustomSourceUrlText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Opacity="0.8" />
            </Grid>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="TUF" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center">
                    <Hyperlink NavigateUri="https://tuforums.com/mods" Click="WebLink_Click" RequestNavigate="WebLink_RequestNavigate">https://tuforums.com/mods</Hyperlink>
                </TextBlock>
            </Grid>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="modlist" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center">
                    <Hyperlink NavigateUri="https://modlist.org" Click="WebLink_Click" RequestNavigate="WebLink_RequestNavigate">https://modlist.org</Hyperlink>
                </TextBlock>
            </Grid>

            <!-- 启用的来源 -->
            <TextBlock Margin="0,20,0,6" FontSize="14" FontWeight="SemiBold" Text="启用的来源" />
            <TextBlock Margin="0,0,0,8"
                       FontSize="12"
                       Opacity="0.6"
                       Text="关掉的来源不会出现在「在线 Mod」的来源列表里，检查更新时也会跳过——站点慢的时候关掉它能让软件更快、更安静。至少要保留一个。"
                       TextWrapping="Wrap" />
            <WrapPanel>
                <CheckBox x:Name="SourceSiteCheck"
                          Margin="0,0,18,8"
                          Checked="SourceEnabled_Changed"
                          Content="ADOFAITools"
                          Unchecked="SourceEnabled_Changed" />
                <CheckBox x:Name="SourceModriftCheck"
                          Margin="0,0,18,8"
                          Checked="SourceEnabled_Changed"
                          Content="modrift"
                          Unchecked="SourceEnabled_Changed" />
                <CheckBox x:Name="SourceTufCheck"
                          Margin="0,0,18,8"
                          Checked="SourceEnabled_Changed"
                          Content="TUF"
                          Unchecked="SourceEnabled_Changed" />
                <CheckBox x:Name="SourceModlistCheck"
                          Margin="0,0,18,8"
                          Checked="SourceEnabled_Changed"
                          Content="modlist"
                          Unchecked="SourceEnabled_Changed" />
                <CheckBox x:Name="SourceCustomCheck"
                          Margin="0,0,18,8"
                          Checked="SourceEnabled_Changed"
                          Content="自定义站点"
                          Unchecked="SourceEnabled_Changed"
                          Visibility="Collapsed" />
                <CheckBox x:Name="SourceGitHubCheck"
                          Margin="0,0,18,8"
                          Checked="CheckGitHub_Changed"
                          Content="GitHub（仅检查更新）"
                          ToolTip="GitHub 不是内容来源，不会出现在「在线 Mod」的来源列表里；关掉后检查更新会跳过各 mod 的 GitHub 仓库。"
                          Unchecked="CheckGitHub_Changed" />
            </WrapPanel>
            <TextBlock x:Name="SourceToggleHint"
                       FontSize="12"
                       Opacity="0.75"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       FontSize="12"
                       Opacity="0.55"
                       Text="GitHub 只用于检查各 mod 的更新，不会作为「在线 Mod」的来源出现。"
                       TextWrapping="Wrap" />

            <!-- 默认站点（ADOFAITools） -->
            <TextBlock x:Name="SiteSectionTitle"
                       Margin="0,32,0,8"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="ADOFAITools" />
            <TextBlock Margin="0,0,0,4" FontSize="12" Opacity="0.6" Text="站点地址（URL）" />
            <ui:TextBox x:Name="ApiBaseUrlBox"
                        PlaceholderText="https://www.adofaitools.top"
                        TextChanged="ApiBaseUrlBox_TextChanged" />
            <TextBlock Margin="0,10,0,4"
                       FontSize="12"
                       Opacity="0.6"
                       Text="API key（该站点要求鉴权时填写；在站点的「个人中心」创建）" />
            <ui:PasswordBox x:Name="ApiKeyBox"
                            PasswordChar="●"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            PasswordChanged="ApiKeyBox_PasswordChanged"
                            RevealButtonEnabled="True" />
            <TextBlock Margin="0,10,0,4"
                       FontSize="12"
                       Opacity="0.6"
                       Text="显示名称（留空则按地址自动判断）" />
            <ui:TextBox x:Name="SiteNameBox"
                        PlaceholderText="留空 = ADOFAITools"
                        TextChanged="SiteNameBox_TextChanged" />
            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <ui:Button Click="TestApi_Click"
                           Content="测试连接"
                           Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
                <ui:Button Margin="8,0,0,0" Click="OpenSite_Click" Content="打开站点" />
            </StackPanel>
            <TextBlock x:Name="ApiStatusText"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.75"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.6"
                       Text="这里默认是 ADOFAITools；填任何实现相同接口的站点地址也能用（接入规范见 docs/RESOURCE-SITE-API.md）。API key 只保存在本机，公开版本不内置任何 key。"
                       TextWrapping="Wrap" />

            <!-- 自定义站点 -->
            <TextBlock Margin="0,32,0,8" FontSize="16" FontWeight="SemiBold" Text="自定义站点" />
            <TextBlock Margin="0,0,0,8"
                       FontSize="12"
                       Opacity="0.6"
                       Text="想再接入一个「同款接口」的站点时填这里（留空表示不启用）。填好后它会作为一项出现在「在线 Mod」的来源列表里，和上面的默认站点互不影响。"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,0,0,4" FontSize="12" Opacity="0.6" Text="名称" />
            <ui:TextBox x:Name="CustomSiteNameBox"
                        PlaceholderText="留空则显示「自定义站点」"
                        TextChanged="CustomSite_TextChanged" />
            <TextBlock Margin="0,10,0,4" FontSize="12" Opacity="0.6" Text="站点地址（URL）" />
            <ui:TextBox x:Name="CustomSiteUrlBox"
                        PlaceholderText="https://example.com"
                        TextChanged="CustomSite_TextChanged" />
            <TextBlock Margin="0,10,0,4" FontSize="12" Opacity="0.6" Text="API key（可留空）" />
            <ui:PasswordBox x:Name="CustomSiteKeyBox"
                            PasswordChar="●"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            PasswordChanged="CustomSiteKey_Changed"
                            RevealButtonEnabled="True" />

            <!-- 更新检查 -->
            <TextBlock Margin="0,32,0,8" FontSize="16" FontWeight="SemiBold" Text="更新检查" />
            <CheckBox x:Name="CheckOnStartupBox"
                      Checked="CheckOnStartup_Changed"
                      Content="打开软件时自动检查更新"
                      Unchecked="CheckOnStartup_Changed" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.6"
                       Text="检查时会查询「启用的来源」里勾选的站点，以及 GitHub（可在上面关掉）。版本取更高的那个；GitHub 在国内可能连不上，连不上会自动忽略。"
                       TextWrapping="Wrap" />

            <!-- 其它 -->
            <StackPanel x:Name="RerunWizardPanel">
                <TextBlock Margin="0,32,0,8" FontSize="16" FontWeight="SemiBold" Text="其它" />
                <ui:Button HorizontalAlignment="Left"
                           Click="RerunWizard_Click"
                           Content="重新运行首次使用向导" />
            </StackPanel>

            <!-- 关于 -->
            <TextBlock Margin="0,32,0,8" FontSize="16" FontWeight="SemiBold" Text="关于" />
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="AppVersionText"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold" />
                <ui:Button Margin="12,0,0,0"
                           Click="CheckAppUpdate_Click"
                           Content="检查更新"
                           Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
                <ui:Button x:Name="AppUpdateNowButton"
                           Margin="8,0,0,0"
                           Appearance="Primary"
                           Click="AppUpdateNow_Click"
                           Content="立即更新"
                           Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"
                           ToolTip="自动下载并替换为新版本（绿色版解压覆盖；安装版会调用安装程序）"
                           Visibility="Collapsed" />
            </StackPanel>
            <ProgressBar x:Name="AppUpdateProgress"
                         Height="4"
                         Margin="0,10,0,0"
                         Visibility="Collapsed" />
            <TextBlock x:Name="AppUpdateStatusText"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.75"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,12,0,0"
                       Opacity="0.7"
                       Text="基于 UnityModManager（MIT，© 2018 newman55）。本软件同样以 MIT 许可开源。"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ConfigPathText"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.5"
                       TextWrapping="Wrap" />

            <!-- 诊断与反馈 -->
            <TextBlock Margin="0,32,0,8" FontSize="16" FontWeight="SemiBold" Text="诊断与反馈" />
            <CheckBox x:Name="DiagnosticLogBox"
                      Checked="DiagnosticLog_Changed"
                      Content="记录诊断日志（反馈问题时用，默认开启）"
                      Unchecked="DiagnosticLog_Changed" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.6"
                       TextWrapping="Wrap"
                       Text="日志保存在本机用户目录，单文件最多 2 MB、超出自动轮转，写之前会脱敏 API key 和下载签名。关掉后只保留崩溃日志。" />
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <ui:Button Click="OpenLogFolder_Click"
                           Content="打开日志文件夹"
                           Icon="{ui:SymbolIcon Symbol=FolderOpen24}" />
                <ui:Button Margin="8,0,0,0"
                           Click="ExportDiagnostics_Click"
                           Content="导出诊断包"
                           Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" />
                <ui:Button Margin="8,0,0,0"
                           Click="ReportIssue_Click"
                           Content="反馈问题" />
            </StackPanel>
            <TextBlock x:Name="DiagnosticsStatusText"
                       Margin="0,10,0,0"
                       FontSize="12"
                       Opacity="0.75"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
