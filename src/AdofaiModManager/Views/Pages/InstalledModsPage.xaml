<Page x:Class="AdofaiModManager.Views.Pages.InstalledModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:svc="clr-namespace:AdofaiModManager.Services"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="已安装">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="InstalledModCardTemplate">
            <Border Margin="0,0,0,8"
                    Padding="14,12"
                    Background="{DynamicResource AmmCardBackgroundBrush}"
                    BorderBrush="{DynamicResource AmmCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="42"
                            Height="42"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="9">
                        <Grid>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="{Binding Initial}" />
                            <Image Source="{Binding IconSource}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{Binding DisplayName}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Margin="8,0,0,0"
                                    Padding="7,1"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="5">
                                <TextBlock FontSize="10"
                                           Opacity="0.65"
                                           Text="{Binding LoaderShortLabel}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding CompactInfo}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,1,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding RequirementsLabel}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <ui:ToggleSwitch Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                         IsEnabled="{Binding CanToggle}"
                                         Checked="ToggleEnabled_Changed"
                                         Unchecked="ToggleEnabled_Changed"
                                         ToolTip="启用 / 禁用" />
                        <ui:Button Margin="0,0,6,0"
                                   Appearance="Primary"
                                   Click="Update_Click"
                                   Content="更新"
                                   Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />
                        <ui:Button Click="More_Click"
                                   Content="⋯"
                                   FontSize="17"
                                   ToolTip="更多操作" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Margin="0,8,0,0">
                        <TextBlock FontSize="11"
                                   Opacity="0.45"
                                   Text="{Binding UpdateSourceLabel}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasUpdateSource, Converter={StaticResource BoolToVis}}" />
                        <TextBlock FontSize="11"
                                   Foreground="#2E9E5B"
                                   Text="{Binding UpdateStatus}"
                                   Visibility="{Binding HasUpdateStatus, Converter={StaticResource BoolToVis}}" />
                        <TextBlock FontSize="11"
                                   Foreground="#E06C5A"
                                   Text="{Binding CompatibilityWarning}"
                                   TextWrapping="Wrap" />
                        <TextBlock FontSize="11"
                                   Foreground="#E06C5A"
                                   Text="{Binding DuplicateWarning}"
                                   TextWrapping="Wrap" />
                        <TextBlock FontSize="11"
                                   Foreground="#E06C5A"
                                   Text="{Binding CrossLoaderWarning}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="已安装的 Mod" />
                <TextBlock x:Name="SummaryText"
                           Margin="0,3,0,0"
                           FontSize="12"
                           Opacity="0.55"
                           Text="正在读取…" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <ui:Button x:Name="CheckAllButton"
                           Margin="0,0,8,0"
                           Click="CheckAll_Click"
                           Content="检查更新"
                           Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
                <ui:Button Margin="0,0,8,0"
                           Click="Refresh_Click"
                           Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                           ToolTip="刷新" />
                <ui:Button Appearance="Primary"
                           Click="InstallZip_Click"
                           Content="安装本地 zip"
                           Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" />
            </StackPanel>
        </Grid>

        <ui:InfoBar x:Name="StatusBar"
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    IsClosable="True"
                    IsOpen="False" />

        <ScrollViewer x:Name="ModsScroller"
                      Grid.Row="2"
                      Margin="0,12,0,0"
                      svc:SmoothScroll.IsEnabled="True"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="ModsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <Grid Margin="0,0,4,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.8"
                                                   Text="{Binding Title}" />
                                        <Border Margin="8,0,0,0"
                                                Padding="7,1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                CornerRadius="5">
                                            <TextBlock FontSize="10"
                                                       Opacity="0.55"
                                                       Text="{Binding Count}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Mods}"
                                              ItemTemplate="{StaticResource InstalledModCardTemplate}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyHint"
                           Margin="0,80,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontSize="14"
                           Opacity="0.55"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
