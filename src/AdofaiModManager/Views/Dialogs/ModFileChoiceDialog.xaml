<ui:FluentWindow x:Class="AdofaiModManager.Views.Dialogs.ModFileChoiceDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                Title="选择要更新的文件"
                Icon="pack://application:,,,/Assets/app.ico"
                Width="560"
                Height="430"
                ResizeMode="NoResize"
                ShowInTaskbar="False"
                WindowStartupLocation="CenterOwner"
                ExtendsContentIntoTitleBar="True"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                WindowBackdropType="Mica"
                WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBarControl" Grid.Row="0" Title="选择要更新的文件">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-128.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24,8,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeadlineText"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="1"
                       Margin="0,8,0,12"
                       FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Text="同一个版本提供多个文件时，请选择要安装的那一个。选择会记住，下次更新同名变体会自动预选。" />

            <ListBox x:Name="FileList"
                     Grid.Row="2"
                     SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="12"
                                       Opacity="0.7">
                                <Run Text="{Binding SizeLabel, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="3"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0" Click="Cancel_Click" Content="取消" />
                <ui:Button Appearance="Primary" Click="Ok_Click" Content="更新" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
