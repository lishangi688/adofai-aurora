<ui:FluentWindow x:Class="AdofaiModManager.Views.Dialogs.FirstRunWizard"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                Title="首次使用向导"
                Icon="pack://application:,,,/Assets/app.ico"
                Width="780"
                Height="580"
                ResizeMode="NoResize"
                ShowInTaskbar="True"
                WindowStartupLocation="CenterScreen"
                ExtendsContentIntoTitleBar="True"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                WindowBackdropType="Mica"
                WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBarControl" Grid.Row="0" Title="首次使用向导">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-128.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 步骤指示 -->
        <StackPanel Grid.Row="1" Margin="32,4,32,0" Orientation="Horizontal">
            <TextBlock x:Name="Step1Label" FontWeight="SemiBold" Text="① 游戏目录" />
            <TextBlock x:Name="Step2Label" Margin="24,0,0,0" Opacity="0.4" Text="② UMM 加载器" />
            <TextBlock x:Name="Step3Label" Margin="24,0,0,0" Opacity="0.4" Text="③ 资源站" />
        </StackPanel>

        <!-- 步骤内容 -->
        <Grid Grid.Row="2" Margin="32,18,32,0">

            <!-- 第 1 步 -->
            <StackPanel x:Name="Step1Panel">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="游戏目录" />
                <TextBlock Margin="0,8,0,0"
                           Opacity="0.75"
                           TextWrapping="Wrap"
                           Text="Aurora 需要知道《冰与火之舞》装在哪里。一般会自动识别，识别不到时可以手动选择。" />

                <ui:TextBox x:Name="GamePathBox"
                            Margin="0,16,0,0"
                            PlaceholderText="例如 D:\SteamLibrary\steamapps\common\A Dance of Fire and Ice"
                            TextChanged="GamePathBox_TextChanged" />
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <ui:Button Click="AutoDetect_Click"
                               Content="自动检测"
                               Icon="{ui:SymbolIcon Symbol=Search24}" />
                    <ui:Button Margin="8,0,0,0"
                               Click="Browse_Click"
                               Content="浏览…"
                               Icon="{ui:SymbolIcon Symbol=FolderOpen24}" />
                </StackPanel>
                <TextBlock x:Name="GameStatusText" Margin="0,14,0,0" Opacity="0.85" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 第 3 步：加载器 -->
            <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="UMM 加载器" />
                <TextBlock Margin="0,8,0,0"
                           Opacity="0.75"
                           TextWrapping="Wrap"
                           Text="mod 需要游戏内的 UnityModManager 加载器才能生效。下面会按版本号告诉你哪个更合适；两种都行，装完这里显示「已就绪」就可以继续。" />

                <Border Margin="0,16,0,0"
                        Padding="16"
                        Background="{DynamicResource AmmCardBackgroundBrush}"
                        BorderBrush="{DynamicResource AmmCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock x:Name="LoaderStatusText" TextWrapping="Wrap" />
                        <TextBlock x:Name="SiteKernelText"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   Opacity="0.8"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                    <ui:Button x:Name="InstallFromSiteButton"
                               Click="InstallFromSite_Click"
                               Content="从 ADOFAITools 获取最新"
                               Icon="{ui:SymbolIcon Symbol=CloudArrowDown24}" />
                    <ui:Button x:Name="InstallBundledButton"
                               Margin="8,0,0,0"
                               Click="InstallBundled_Click"
                               Content="使用内置内核" />
                    <ui:Button x:Name="ImportKernelButton"
                               Margin="8,0,0,0"
                               Click="ImportKernel_Click"
                               Content="导入本地 zip" />
                </StackPanel>

                <!-- 推荐用哪个（按版本号 / 有没有填 API key 自动判断） -->
                <Border x:Name="KernelAdviceBox"
                        Margin="0,12,0,0"
                        Padding="12,10"
                        Visibility="Collapsed"
                        Background="{DynamicResource AmmCardBackgroundBrush}"
                        BorderBrush="{DynamicResource AmmCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock x:Name="KernelAdviceText"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Border>
                <TextBlock Margin="0,12,0,0"
                           FontSize="12"
                           Opacity="0.6"
                           TextWrapping="Wrap"
                           Text="若这里显示「已就绪」，说明加载器装好了，可直接下一步。游戏大更新后可能需要点一下修复。" />
            </StackPanel>

            <!-- 第 3 步：资源站 -->
            <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="资源站" />
                <TextBlock Margin="0,8,0,0"
                           Opacity="0.75"
                           TextWrapping="Wrap"
                           Text="选择要启用的 Mod 来源。默认只勾选 ADOFAITools —— 它最稳定、访问也快；其它来源以后可以在「设置 → 启用的来源」里随时打开。" />

                <Border Margin="0,16,0,0"
                        Padding="16"
                        Background="{DynamicResource AmmCardBackgroundBrush}"
                        BorderBrush="{DynamicResource AmmCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <CheckBox x:Name="WizardSiteCheck"
                                  Checked="WizardSource_Changed"
                                  Content="ADOFAITools（推荐）"
                                  Unchecked="WizardSource_Changed" />
                        <TextBlock Margin="26,4,0,0"
                                   FontSize="12"
                                   Opacity="0.65"
                                   TextWrapping="Wrap"
                                   Text="已内置公共 key，开箱即用，不需要登录。之后如果在「设置」里填了自己的 key，会优先使用自己的。" />
                        <WrapPanel Margin="0,12,0,0">
                            <CheckBox x:Name="WizardModriftCheck"
                                      Margin="0,0,18,8"
                                      Checked="WizardSource_Changed"
                                      Content="modrift"
                                      Unchecked="WizardSource_Changed" />
                            <CheckBox x:Name="WizardTufCheck"
                                      Margin="0,0,18,8"
                                      Checked="WizardSource_Changed"
                                      Content="TUF"
                                      Unchecked="WizardSource_Changed" />
                            <CheckBox x:Name="WizardModlistCheck"
                                      Margin="0,0,18,8"
                                      Checked="WizardSource_Changed"
                                      Content="modlist"
                                      Unchecked="WizardSource_Changed" />
                            <CheckBox x:Name="WizardCustomCheck"
                                      Margin="0,0,18,8"
                                      Checked="WizardSource_Changed"
                                      Content="自定义站点"
                                      Unchecked="WizardSource_Changed"
                                      Visibility="Collapsed" />
                        </WrapPanel>
                        <TextBlock x:Name="WizardSourceHint"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Opacity="0.75"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                    <ui:Button Click="TestWizardApi_Click"
                               Content="测试 ADOFAITools 连接"
                               Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
                    <ui:Button Margin="8,0,0,0" Click="OpenSite_Click" Content="打开 ADOFAITools" />
                </StackPanel>
                <TextBlock x:Name="WizardApiStatusText"
                           Margin="0,10,0,0"
                           FontSize="12"
                           Opacity="0.8"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,10,0,0"
                           FontSize="12"
                           Opacity="0.55"
                           TextWrapping="Wrap"
                           Text="GitHub 只用于检查 Mod 更新，不会作为内容来源；可以在「设置 → 启用的来源」里单独关闭。" />
            </StackPanel>
        </Grid>

        <ui:InfoBar x:Name="StatusBar"
                    Grid.Row="2"
                    Margin="32,0,32,0"
                    VerticalAlignment="Bottom"
                    IsClosable="True"
                    IsOpen="False" />

        <!-- 底部按钮 -->
        <Grid Grid.Row="3" Margin="32,18,32,20">
            <ui:Button x:Name="SkipStepButton"
                       HorizontalAlignment="Left"
                       Click="SkipStep_Click"
                       Content="跳过这步" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button x:Name="BackButton"
                           Margin="0,0,8,0"
                           Click="Back_Click"
                           Content="上一步" />
                <ui:Button x:Name="NextButton"
                           Appearance="Primary"
                           Click="Next_Click"
                           Content="下一步" />
                <ui:Button x:Name="FinishButton"
                           Appearance="Primary"
                           Click="Finish_Click"
                           Content="完成"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
