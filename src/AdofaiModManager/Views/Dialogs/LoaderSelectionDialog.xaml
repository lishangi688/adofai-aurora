<ui:FluentWindow x:Class="AdofaiModManager.Views.Dialogs.LoaderSelectionDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                Title="选择加载器"
                Icon="pack://application:,,,/Assets/app.ico"
                Width="760"
                Height="660"
                MinWidth="680"
                MinHeight="520"
                ResizeMode="CanResize"
                ShowInTaskbar="False"
                WindowStartupLocation="CenterOwner"
                ExtendsContentIntoTitleBar="True"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                WindowBackdropType="Mica"
                WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBarControl" Grid.Row="0" Title="选择加载器">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-128.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" Margin="28,8,28,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="选择游戏加载器" />
                <TextBlock Margin="0,8,0,0"
                           Opacity="0.65"
                           TextWrapping="Wrap"
                           Text="选择要安装的加载器；UMM + MelonLoader 需要勾选下方的兼容层。" />

                <ItemsControl x:Name="LoaderList" Margin="0,18,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="14"
                                    Background="{DynamicResource AmmCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource AmmCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Checked="Loader_Changed"
                                              Unchecked="Loader_Changed" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Title}" />
                                            <Border Margin="8,0,0,0"
                                                    Padding="7,1"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    CornerRadius="5">
                                                <TextBlock FontSize="10"
                                                           Opacity="0.65"
                                                           Text="{Binding Badge}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="12"
                                                   Opacity="0.62"
                                                   Text="{Binding Description}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="12"
                                                   Foreground="#E06C5A"
                                                   Text="{Binding StatusText}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <ComboBox Grid.Column="2"
                                              Width="220"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Center"
                                              DisplayMemberPath="DisplayLabel"
                                              ItemsSource="{Binding Versions}"
                                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                              SelectionChanged="Version_Changed" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="CompatPanel"
                        Margin="0,8,0,0"
                        Padding="14"
                        Background="{DynamicResource AmmCardBackgroundBrush}"
                        BorderBrush="{DynamicResource AmmCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="CompatCheck"
                                  Grid.Column="0"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"
                                  Checked="Compat_Changed"
                                  Unchecked="Compat_Changed" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="UMMBridge" />
                                <Border Margin="8,0,0,0"
                                        Padding="7,1"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        CornerRadius="5">
                                    <TextBlock FontSize="10"
                                               Opacity="0.65"
                                               Text="兼容层" />
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="12"
                                       Opacity="0.62"
                                       TextWrapping="Wrap"
                                       Text="让 MelonLoader 也能加载 UMM mod（UMM 目录改为 UMMMods）。" />
                        </StackPanel>

                        <ComboBox x:Name="CompatVersionCombo"
                                  Grid.Column="2"
                                  Width="220"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  DisplayMemberPath="DisplayLabel"
                                  SelectionChanged="Version_Changed" />
                    </Grid>
                </Border>

                <ui:InfoBar x:Name="StatusBar"
                            Margin="0,14,0,0"
                            IsClosable="True"
                            IsOpen="False" />

                <TextBlock Margin="0,12,0,0"
                           FontSize="12"
                           Opacity="0.5"
                           TextWrapping="Wrap"
                           Text="UMM + MelonLoader 需要 UMMBridge；其它组合不能共存。" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="28,16,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="ProgressText"
                           FontSize="12"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
                <ProgressBar x:Name="InstallProgress"
                             Height="4"
                             Margin="0,6,20,0"
                             Maximum="100"
                             Minimum="0"
                             Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0"
                           Click="Cancel_Click"
                           Content="取消" />
                <ui:Button x:Name="InstallButton"
                           Appearance="Primary"
                           Click="Install_Click"
                           Content="安装所选加载器"
                           Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
