    <Compile Include="..\..\src\AdofaiModManager\Services\AppPaths.cs" />
    <Compile Include="..\..\src\AdofaiModManager\Services\Sources\RemoteModels.cs" />
    <Compile Include="..\..\src\AdofaiModManager\Services\Sources\TufSource.cs" />
    <Compile Include="..\..\src\AdofaiModManager\Services\Sources\ModlistSource.cs" />
    <Compile Include="..\..\src\AdofaiModManager\Services\Sources\ModriftSource.cs" />
  </ItemGroup>

</Project>
