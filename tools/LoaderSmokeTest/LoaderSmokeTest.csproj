<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LoaderSmokeTest</RootNamespace>
    <AssemblyName>LoaderSmokeTest</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\AdofaiModManager\Services\AppPaths.cs" />
    <Compile Include="..\..\src\AdofaiModManager\Services\DownloadService.cs" />
    <Compile Include="..\..\src\AdofaiModManager\Services\LoaderService.cs" />
    <Compile Include="..\..\src\AdofaiModManager\Services\KernelService.cs" />
    <Compile Include="..\..\src\AdofaiModManager\Services\InstallResult.cs" />
    <Compile Include="..\..\src\AdofaiModManager\Services\SteamGameLocator.cs" />
    <Compile Include="..\..\src\AdofaiModManager\Models\KernelManifest.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\AdofaiModManager\Resources\UmmLoader\**\*">
      <Link>Resources\UmmLoader\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
